<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingEnd="64dp"
        android:paddingTop="36dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/hook_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hook_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/mid"
            android:textSize="15sp" />

        <!-- Button -->
        <TextView style="@style/SectionHeader" android:text="@string/section_button" />

        <EditText
            android:id="@+id/hook_label"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:hint="@string/hook_label_hint"
            android:inputType="textCapWords" />

        <!-- Actions -->
        <TextView style="@style/SectionHeader" android:text="@string/section_endpoints" />

        <LinearLayout
            android:id="@+id/block_single"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Label"
                android:layout_marginTop="12dp"
                android:text="@string/label_single" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/name_single"
                    style="@style/Field"
                    android:layout_width="260dp"
                    android:layout_marginEnd="12dp"
                    android:hint="@string/name_hint"
                    android:inputType="textCapSentences" />

                <EditText
                    android:id="@+id/url_single"
                    style="@style/Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="@string/url_hint"
                    android:inputType="textUri" />

                <Button
                    android:id="@+id/test_single"
                    style="@style/FlatButton"
                    android:layout_marginStart="12dp"
                    android:text="@string/test" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/method_single"
                    style="@style/FlatButton"
                    android:layout_width="260dp"
                    android:layout_marginEnd="12dp" />

                <EditText
                    android:id="@+id/body_single"
                    style="@style/Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="@string/body_hint"
                    android:inputType="text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/block_double"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Label"
                android:layout_marginTop="16dp"
                android:text="@string/label_double" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/name_double"
                    style="@style/Field"
                    android:layout_width="260dp"
                    android:layout_marginEnd="12dp"
                    android:hint="@string/name_hint"
                    android:inputType="textCapSentences" />

                <EditText
                    android:id="@+id/url_double"
                    style="@style/Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="@string/url_hint"
                    android:inputType="textUri" />

                <Button
                    android:id="@+id/test_double"
                    style="@style/FlatButton"
                    android:layout_marginStart="12dp"
                    android:text="@string/test" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/method_double"
                    style="@style/FlatButton"
                    android:layout_width="260dp"
                    android:layout_marginEnd="12dp" />

                <EditText
                    android:id="@+id/body_double"
                    style="@style/Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="@string/body_hint"
                    android:inputType="text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/block_hold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Label"
                android:layout_marginTop="16dp"
                android:text="@string/label_hold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/name_hold"
                    style="@style/Field"
                    android:layout_width="260dp"
                    android:layout_marginEnd="12dp"
                    android:hint="@string/name_hint"
                    android:inputType="textCapSentences" />

                <EditText
                    android:id="@+id/url_hold"
                    style="@style/Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="@string/url_hint"
                    android:inputType="textUri" />

                <Button
                    android:id="@+id/test_hold"
                    style="@style/FlatButton"
                    android:layout_marginStart="12dp"
                    android:text="@string/test" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/method_hold"
                    style="@style/FlatButton"
                    android:layout_width="260dp"
                    android:layout_marginEnd="12dp" />

                <EditText
                    android:id="@+id/body_hold"
                    style="@style/Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="@string/body_hint"
                    android:inputType="text" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Label"
            android:layout_marginTop="16dp"
            android:text="@string/label_headers" />

        <EditText
            android:id="@+id/headers"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_marginTop="6dp"
            android:gravity="top"
            android:hint="@string/headers_hint"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="2"
            android:singleLine="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/endpoint_help"
            android:textColor="@color/mid"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/save"
                style="@style/FlatButton"
                android:text="@string/save" />

            <Button
                android:id="@+id/remove"
                style="@style/FlatButton"
                android:layout_marginStart="12dp"
                android:text="@string/remove_hook" />

            <TextView
                android:id="@+id/last_result"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:textColor="@color/mid"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
